# KL ERP portal credentials (required for the automated ERP login)
ERP_USERNAME=YOUR_ERP_ROLLNUMBER_OR_USERNAME
ERP_PASSWORD=YOUR_ERP_PASSWORD

# Public app URL (for webhook registration)
APP_URL=https://YOUR-PUBLIC-URL.com
